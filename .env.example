# Copy to .env and fill in. .env is git-ignored; real environment variables override it.

# Which LLM: minimax | anthropic | openai (any OpenAI-compatible server)
HEX_BACKEND=minimax

# --- MiniMax ---
MINIMAX_API_KEY=
# HEX_MODEL=MiniMax-M3              # default; or MiniMax-M3.1-Flash
# HEX_BASE_URL=https://api.minimaxi.com/v1   # only for mainland-China accounts

# --- Anthropic ---
# ANTHROPIC_API_KEY=
# HEX_MODEL=claude-sonnet-5-5

# --- Local / OpenAI-compatible (Ollama, LM Studio, llama.cpp) ---
# HEX_BASE_URL=http://localhost:11434/v1
# HEX_MODEL=qwen3:14b
# OPENAI_API_KEY=none

# --- MUD ---
# HEX_HOST=discworld.starturtle.net
# HEX_PORT=23                        # 4242 if 23 is blocked
